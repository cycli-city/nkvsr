# ============================================================================================
# WindScope UK - configuration. Copy to `.env` (never commit it). Every value has a safe default.
# Placeholders only: this project needs NO secrets to read Elexon's open data.
#
# NOTE: comments are on their own lines on purpose. Docker Compose, python-dotenv and shells treat
# an inline `# comment` after an empty value differently (Compose would make the comment the value).
# ============================================================================================

# --- runtime ---------------------------------------------------------------------------------
# development | test | production. Production REFUSES to serve synthetic development data.
APP_ENV=production
LOG_LEVEL=INFO
# Browser origins allowed to call the API (comma separated). Add your Vercel URL when deploying.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- analysis semantics (see docs/02-DOMAIN-ASSUMPTIONS.md) ----------------------------------
# Month of purchase decisions under analysis (YYYY-MM).
ANALYSIS_MONTH=2026-01
# decision_date = the literal reading of the brief; delivery_date = power delivered in the month.
DEFAULT_BASIS=decision_date
# Decision cutoff, Europe/London, on the day before delivery (09:20 = earliest GB day-ahead gate closure).
DECISION_CUTOFF_LOCAL=09:20
MAX_RANGE_DAYS=62
# Share of expected half-hours matched at/above which the analysis is "sufficient" / "partial".
COVERAGE_SUFFICIENT=0.98
COVERAGE_PARTIAL=0.90
STALE_FORECAST_HOURS=36
# Minutes between a half-hour ending and its actual being usable (baseline leakage guard; an assumption,
# a later recorded publication time always wins).
ACTUAL_AVAILABILITY_LAG_MINUTES=30
# WINDFOR is hourly but FUELHH half-hourly (observed live). hold = apply each forecast hour to both half-hours
# it covers (default); exact = only match identical start times, the other half-hours are reported missing.
FORECAST_ALIGNMENT=hold

# --- data -------------------------------------------------------------------------------------
# Snapshots live in $DATA_DIR/snapshots/current (docker compose overrides this to /app/data).
DATA_DIR=./data
# Folder name under $DATA_DIR/snapshots that holds the active snapshot.
SNAPSHOT_NAME=current
# true = if no snapshot exists, fetch from Elexon on first boot (needs internet access).
AUTO_INGEST_ON_START=false
# Leave EMPTY to keep POST /api/admin/refresh disabled. Set a long random string to enable it
# (clients then send it in the X-Admin-Token header).
ADMIN_TOKEN=

# --- performance and abuse protection ---------------------------------------------------------
# Requests per minute allowed per client before HTTP 429. 0 disables the limiter. Health checks are exempt.
RATE_LIMIT_PER_MINUTE=300
# Seconds a browser may reuse an analytics response without asking again (responses always carry an ETag).
BROWSER_CACHE_SECONDS=300
# Compute the default dashboard views in the background at start-up so the first visitor is not slow.
PREWARM_ON_START=true

# --- Elexon upstream (used only by ingestion, never by request handlers) ---------------------
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_TIMEOUT_SECONDS=60
ELEXON_CONNECT_TIMEOUT_SECONDS=10
ELEXON_MAX_RETRIES=4
ELEXON_BACKOFF_SECONDS=1.0
ELEXON_CONCURRENCY=3
ELEXON_ACTUALS_CHUNK_DAYS=7
ELEXON_FORECAST_CHUNK_DAYS=2
# WINDFOR publications fetched this many days before the first delivery day.
FORECAST_LOOKBACK_DAYS=4
# FUELHH history needed by the trailing-mean baseline.
ACTUALS_LOOKBACK_DAYS=10

# --- docker compose ports ---------------------------------------------------------------------
WEB_PORT=8080
API_PORT=8000
